# Server
NODE_ENV=development
PORT=3000

# Database — matches docker-compose.yml's postgres service (see docs/infrastructure.md)
DATABASE_URL=postgresql://inspot:inspot_dev_password@localhost:5432/inspot_dev?schema=public

# Redis — matches docker-compose.yml's redis service
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK — Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
